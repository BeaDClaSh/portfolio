{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react"
  },
  "include": [
    "src/**/*.tsx",
    "src/**/*.jsx",
    "declaration.d.ts",
    "src/Pages/aos.d.ts",
    "src/Components/*.jsx",
    "tailwind.config.ts",
    "src/*.ts"
  ]
}
